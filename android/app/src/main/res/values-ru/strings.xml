    <!-- Accessibility service -->
    <string name="accessibility_label">Syncliko: автоотправка</string>
    <string name="accessibility_summary">Отправляет скопированное на Mac</string>
    <string name="accessibility_description">Syncliko отслеживает только момент копирования (нажатие «Копировать» или сообщение «Скопировано») и после этого отправляет буфер обмена на ваш Mac. Содержимое экрана не читается и не сохраняется.</string>

