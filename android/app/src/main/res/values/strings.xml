    <string name="app_name" translatable="false">Syncliko</string>
    <string name="send_to_mac">Send to Mac</string>

    <!-- Accessibility service -->
    <string name="accessibility_label">Syncliko automatic sending</string>
    <string name="accessibility_summary">Sends what you copy to your Mac</string>
    <string name="accessibility_description">Syncliko watches only for the moment you copy something (a tap on “Copy” or a “Copied” message) and then sends the clipboard to your paired Mac. It doesn’t read or store anything on your screen.</string>

    <!-- Onboarding / pairing -->
    <string name="onb_tagline">Copy on your phone, paste on your Mac — and back.</string>
    <string name="onb_step1">Open Syncliko in your Mac’s menu bar</string>
    <string name="onb_step2">Click “Add Device…”</string>
    <string name="onb_step3">Scan the code with this phone</string>
    <string name="onb_scan">Scan QR code</string>
    <string name="onb_paste">Paste pairing link</string>
    <string name="pair_connecting">Connecting to your Mac…</string>
    <string name="pair_confirm_title">Confirm on your Mac</string>
    <string name="pair_confirm_body">Check that %1$s shows the same code, then click “Pair” there.</string>
    <string name="pair_failed_title">Couldn’t pair</string>
    <string name="pair_scan_again">Scan again</string>
    <string name="pair_error_not_code">That isn’t a Syncliko pairing code.</string>
    <string name="pair_error_scanner">Couldn’t open the QR scanner (%1$s). Scan the code with the Camera app instead, or copy the pairing link and tap “Paste pairing link”.</string>
    <string name="pair_error_rejected">Pairing was declined on the Mac.</string>
    <string name="pair_error_certificate">The Mac’s certificate doesn’t match the QR code. Open a new code on the Mac and try again.</string>
    <string name="pair_error_unreachable">Can’t reach the Mac. Make sure both devices are on the same Wi-Fi or connected through Tailscale.</string>
    <string name="pair_error_expired">The code has expired or was already used. Open a new code on the Mac.</string>
